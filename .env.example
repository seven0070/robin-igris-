# OmniRoute LLM gateway (primary brain / router)
# https://github.com/diegosouzapw/OmniRoute
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=omniroute
OMNIROUTE_MODEL=auto
# Offline-first local model id as registered in OmniRoute (Ollama / llama.cpp)
OMNIROUTE_LOCAL_MODEL=local
OMNIROUTE_MODEL_CODING=auto
OMNIROUTE_MODEL_REASONING=auto
OMNIROUTE_MODEL_LONGCTX=auto
OMNIROUTE_MODEL_CHEAP=auto
OMNIROUTE_CLOUD_MIN_BUDGET=0.05
ROBIN_FORCE_OFFLINE=0
# OpenAI SDK aliases (pointed at OmniRoute)
OPENAI_API_KEY=omniroute
OPENAI_BASE_URL=http://127.0.0.1:20128/v1
OPENAI_MODEL=auto

# Optional Hermes API server (tools hub — off by default; LLM is OmniRoute)
HERMES_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=robin-igris-dev
ROBIN_START_HERMES=0
ROBIN_START_OMNIROUTE=1

# Voice bridge
VOICE_HOST=127.0.0.1
VOICE_PORT=8787
TTS_PROVIDER=edge
# edge | openai
EDGE_TTS_VOICE=en-US-JennyNeural

# Companion (Vite) — prefix with VITE_
# Chat hits voice bridge /v1 first (proxies OmniRoute), then Hermes fallback
VITE_HERMES_BASE_URL=/hermes/v1
VITE_HERMES_API_KEY=robin-igris-dev
VITE_VOICE_BASE_URL=http://127.0.0.1:8787
VITE_AGENT_NAME=Robin Igris
